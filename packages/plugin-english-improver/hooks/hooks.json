{
  "description": "English Improver hook - checks predominantly English prompts and adapts output to the active harness",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"${CLAUDE_PLUGIN_ROOT}/hooks/scripts/check-english.ts\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
