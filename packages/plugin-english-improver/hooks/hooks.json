{
  "description": "English Improver hook - checks English grammar on every user prompt via LLM call",
  "hooks": {
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "bun \"$PLUGIN_ROOT/hooks/scripts/check-english.ts\"",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
